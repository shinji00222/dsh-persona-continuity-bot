{
  "name": "dsh-persona-twin",
  "version": "0.2.0-preview.17",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinji00222/dsh-persona-twin-bot.git"
  },
  "homepage": "https://github.com/shinji00222/dsh-persona-twin-bot#readme",
  "bugs": {
    "url": "https://github.com/shinji00222/dsh-persona-twin-bot/issues"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.3 <0.4.0-0"
  },
  "description": "Persistent persona twins with independent local Markdown memory and Bot collaboration mode (DM timeline, multi-persona group chat, primary persona history recall) for DeepSeek Harness.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "persona",
    "persona-twin",
    "digital-twin",
    "persona-memory",
    "agent-memory"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/store.js",
    "lib/local-memory.js",
    "lib/extract.js",
    "lib/history.js",
    "lib/web.js",
    "locale",
    "docs/research.md",
    "docs/project-plan.md",
    "docs/development-log.md",
    "docs/tobs-integration-plan.md",
    "docs/tobs-integration-research.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/store.js && node --check lib/local-memory.js && node --check lib/extract.js && node --check lib/web.js && node --check lib/history.js && node --check lib/simulation.js && node --check scripts/pack-with-tobs.mjs",
    "test": "node --test",
    "pack:tobs": "node scripts/pack-with-tobs.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": ["@deepseek-ai/dsh-client-ui-primitives"]
    }
  }
}
